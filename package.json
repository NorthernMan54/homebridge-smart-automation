{
  "name": "homebridge-smart-automation",
  "displayName": "Homebridge Smart Automation",
  "type": "module",
  "version": "0.1.0",
  "description": "Rules engine for Homebridge: smart light groups, door-left-ajar alerts, humidity control, averaged temperature sensors and a virtual security system.",
  "author": "Northern Man",
  "license": "MIT",
  "homepage": "https://github.com/NorthernMan54/homebridge-smart-automation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthernMan54/homebridge-smart-automation.git"
  },
  "bugs": {
    "url": "https://github.com/NorthernMan54/homebridge-smart-automation/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "main": "dist/index.js",
  "files": [
    "LICENSE",
    "README.md",
    "config.schema.json",
    "dist"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.ui.json",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "watch": "nodemon",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@homebridge/hap-client": "^5.4.0",
    "@homebridge/plugin-ui-utils": "^2.2.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "homebridge": "^2.5.0",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "preact": "^11.1.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,tsx,html,json",
    "ignore": [],
    "exec": "npm run build && NODE_PATH=`pwd`:.. DEBUG=-HAP-NodeJS:* node ~/npm/lib/node_modules/homebridge-config-ui-x/dist/bin/hb-service.js run --stdout -U ./test/hbConfig -T -D -I -P ./",
    "signal": "SIGTERM",
    "env": {
      "NODE_OPTIONS": "--trace-warnings"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
